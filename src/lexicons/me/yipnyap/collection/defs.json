{
  "lexicon": 1,
  "id": "me.yipnyap.collection.defs",
  "defs": {
    "packViewBasic": {
      "type": "object",
      "required": ["displayName", "leader"],
      "properties": {
        "displayName": {
          "type": "string",
          "maxGraphemes": 64,
          "maxLength": 640
        },
        "description": {
          "type": "string",
          "maxGraphemes": 256,
          "maxLength": 2560
        },
        "leader": {
          "type": "string",
          "format": "did"
        },
        "avatar": {
          "type": "blob",
          "accept": ["image/png", "image/jpeg"],
          "maxSize": 1000000
        },
        "banner": {
          "type": "blob",
          "accept": ["image/png", "image/jpeg"],
          "maxSize": 1000000
        },
        "labels": {
          "type": "union",
          "refs": ["com.atproto.label.defs#selfLabels"]
        }
      }
    }
  }
}