# Required for federation
BGS_HOST="bgs.bsky-sandbox.dev" # Remove to disable federation
PLC_HOST="plc.bsky-sandbox.dev" # A PLC server is required, federation or otherwise.

# The host in which this server will be accessible from
PDS_HOST="yipnyap.me"

# Allowed username suffixes, space separated.
# You must own and manage the domains you add here, and they must point to this server.
AUTH_AVAILABLE_USERNAMES=".yipnyap.me"

# Privacy policy and terms of service URLs.
PRIVACY_POLICY_URL="https://yipnyap.me/privacy"
TERMS_OF_SERVICE_URL="https://yipnyap.me/terms"

# Invite code settings
AUTH_LOCKDOWN=1 # Lockdown registration to invite codes only
AUTH_LOCKDOWN_DISTRIBUTE_EXISTING=1 # Provide invite codes to users automatically
AUTH_LOCKDOWN_DISTRIBUTE_AMOUNT=1 # Number of invite codes to provide to each user
AUTH_LOCKDOWN_DISTRIBUTE_FREQUENCY="1d" # How often to provide invite codes to each user, suffixed with d(ay), w(eek), m(onth), or y(ear).

# Storage settings
STORAGE_BACKEND="prisma" # blank for memory